# Pre-hashed htpasswd content. Default user: nagiosadmin / password.
# Change this value before using the image for anything real.
NAGIOS_HTPASSWD='nagiosadmin:$2y$05$LHYHBWkwHrto0OLZhLjjDuGlRXiJEojTJPURKhn9Vsf8M31OcF/aq'

# Set to true when HTTPS is terminated upstream by an ALB or reverse proxy.
NAGIOS_FORCE_SSL=false

# Container timezone used by Nagios and Apache.
TZ=UTC

# SMTP relay used by Nagios notifications. Leave SMTP_HOST empty to disable.
# For local Mailpit testing use SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_AUTH=off, SMTP_TLS=off and SMTP_STARTTLS=off.
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=on
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mailpit web UI port when using: docker compose --profile mailpit up -d
MAILPIT_UI_PORT=8025
