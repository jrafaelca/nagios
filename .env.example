# Optional pre-hashed htpasswd content. Use escaped newlines (\n) for multiple users.
# When set, this takes precedence over etc/htpasswd.users.
NAGIOS_HTPASSWD=

# Set to true when HTTPS is terminated upstream by an ALB or reverse proxy.
NAGIOS_FORCE_SSL=false

# Container timezone used by Nagios and Apache.
TZ=UTC
